{
  "description": "Evolver session context (Proxy state, claim hint) and prompt-relevant Gene/Capsule recall",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/hooks/session-start.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\"",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
